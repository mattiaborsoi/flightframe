# Copy to .env and set your own values. .env is gitignored — keep it that way.
#
# The defaults below (and the defaults compiled into config.py) point at
# Oxford Circus, London. That is deliberate: nothing in the committed tree
# should reveal where a frame actually hangs.

# Where the frame lives. Decimal degrees, north/east positive.
HOME_LAT=51.5154
HOME_LON=-0.1410

# Shown in the footer of rendered posters.
HOME_LABEL=Oxford Circus

# Radius to collect aircraft within, nautical miles (adsb.lol caps at 250).
RADIUS_NM=25

# Frame cadence. Outside the awake window the server returns a long sleep.
REFRESH_MINUTES=15
AWAKE_FROM=07:00
AWAKE_UNTIL=23:00

# Long-exposure accumulation window, hours.
#
# Not the crowding control — that is --max-tracks, which caps how many are
# drawn. Over London even one hour yields ~370 aircraft, far more than the cap,
# so the window decides *which* tracks are chosen rather than how many.
#
# Shorter is better for a different reason: a long window mixes easterly and
# westerly runway operations from across the day, so the corridors cancel each
# other out, and "longest extent" selection then favours high overflights and
# loses the local texture. Three hours spans one runway configuration while
# still reading as an accumulation. Drop to 1 for something closer to "now".
TRACE_HOURS=3

# How long position history is kept. Only TRACE_HOURS is ever rendered, so this
# is pure headroom for widening the window without waiting for it to refill.
# It was 36h against a 3h render window — 40,000 rows to draw 70 tracks.
PRUNE_HOURS=12

# metric (km, metres, km/h) or aviation (nm, feet, knots).
UNITS=metric

# Ignore anything below this. Living near an airport otherwise fills every
# poster with circuit traffic and aircraft on short final, which crowds the
# baseline and tells you nothing. 1000 ft ~ 300 m.
MIN_ALTITUDE_FT=1000

# How far out the cross-section plots. The collector still gathers the full
# RADIUS_NM for the trace and rose; this only zooms the elevation in, because
# at 46 km the near-field arrivals compress into an unreadable smear.
SECTION_RADIUS_KM=25

# Contact address sent as the User-Agent to the public APIs. Be a good citizen:
# adsb.lol and adsbdb are volunteer-funded and free.
USER_AGENT=flightframe/0.1 (+https://github.com/yourname/flightframe)

# Hostnames this deployment answers on (CSRF origin allow-list).
APP_HOSTS=frame.example.com,localhost,127.0.0.1

# Optional schedule API: flights within 7 days get times / aircraft / route
# refreshed twice a day. Without a key, route still autofills; the rest stays
# as entered. Providers:
#   aerodatabox   - RapidAPI key (free 600 units/mo). Richest: departure AND
#                   arrival times, terminal, gate, delay, assigned tail.
#   aviationstack - aviationstack.com key (free 100 calls/mo). Times and
#                   aircraft type only.
# Optional: FlightAware AeroAPI key (Personal plan). Used ONLY to identify
# which aircraft is flying a tracked flight number (tail + real callsign),
# a handful of calls around each departure, hard-capped in code at 100
# calls/month so it can never exceed the plan's included $5.
FLIGHTAWARE_API_KEY=

SCHEDULE_PROVIDER=aerodatabox
SCHEDULE_API_KEY=

# Public hostname of this deployment; used by Caddy for TLS and certificates.
FRAME_DOMAIN=frame.example.com
